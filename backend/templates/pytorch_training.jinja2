import pandas as pd
import torch

BEST_MODEL_NAME = "{{ best_model_name }}"
BEST_PARAMS = {{ best_params }}
TARGET_COLUMN = "{{ target_column }}"
TASK_TYPE = "{{ task_type }}"

dataset = pd.read_csv("cleaned_dataset.csv")
X = dataset.drop(columns=[TARGET_COLUMN]).select_dtypes(include=["number"]).fillna(0.0).astype("float32")
y = dataset[TARGET_COLUMN]

if TASK_TYPE == "classification":
    y_encoded = pd.factorize(y)[0]
    output_dim = 1 if len(set(y_encoded)) <= 2 else len(set(y_encoded))
else:
    y_encoded = y.astype("float32")
    output_dim = 1


class DenseNet(torch.nn.Module):
    def __init__(self, input_dim, output_dim):
        super().__init__()
        self.layers = torch.nn.Sequential(
            torch.nn.Linear(input_dim, 256),
            torch.nn.ReLU(),
            torch.nn.Dropout(0.1),
            torch.nn.Linear(256, 128),
            torch.nn.ReLU(),
            torch.nn.Linear(128, output_dim),
        )

    def forward(self, values):
        return self.layers(values)


model = DenseNet(X.shape[1], output_dim)
optimizer = torch.optim.Adam(model.parameters(), lr=0.001)
criterion = (
    torch.nn.BCEWithLogitsLoss()
    if TASK_TYPE == "classification" and output_dim == 1
    else torch.nn.CrossEntropyLoss()
    if TASK_TYPE == "classification"
    else torch.nn.MSELoss()
)

x_tensor = torch.tensor(X.values, dtype=torch.float32)
if TASK_TYPE == "classification":
    y_tensor = torch.tensor(y_encoded.reshape(-1, 1), dtype=torch.float32) if output_dim == 1 else torch.tensor(y_encoded, dtype=torch.long)
else:
    y_tensor = torch.tensor(y_encoded.values.reshape(-1, 1), dtype=torch.float32)

for _ in range(14):
    optimizer.zero_grad()
    outputs = model(x_tensor)
    loss = criterion(outputs, y_tensor)
    loss.backward()
    optimizer.step()

torch.save(model.state_dict(), "best_model.pt")
print("Trained", BEST_MODEL_NAME, "with", BEST_PARAMS)
